load("@i_pypi//:requirements.bzl", "requirement")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_fusesoc//build:fusesoc_run.bzl", "fusesoc_run")


# This rule shows that `fusesoc` is indeed installed and working.
genrule(
    name = "test",
    srcs = [ ],
    outs = [ "fusesoc.txt" ],
    tools = [
        "@rules_fusesoc//third_party/fusesoc:run_fusesoc",
        requirement("fusesoc"),
    ],
    cmd = "$(location @rules_fusesoc//third_party/fusesoc:run_fusesoc) --help > $@",
)


# These are generated by fusesoc rules.
filegroup(
    name = "muntjac_all",
    # do not sort
    srcs = [
        "@fusesoc_cores//build/lowrisc_muntjac_core_0.1:lowrisc_muntjac_core_0_1_default_vivado_srcs",
        "@fusesoc_cores//build/lowrisc_muntjac_core_0.1:lowrisc_muntjac_core_0_1_default_vivado_hdrs",
        "@fusesoc_cores//build/lowrisc_muntjac_core_0.1:lowrisc_muntjac_core_0_1_default_verilator_srcs",
        "@fusesoc_cores//build/lowrisc_muntjac_core_0.1:lowrisc_muntjac_core_0_1_default_verilator_hdrs",
    ],
)


filegroup(
    name = "srcs",
    # do not sort
    srcs = [
        "@fusesoc_cores//build/fusesoc_utils_blinky_1.1:fusesoc_utils_blinky_1_1_default_vivado_srcs",
    ],
)

verilog_library(
    name = "test_library",
    srcs = [
        ":srcs",
    ],
)


verilator_cc_library(
    name = "lib",
    module = ":test_library",
    module_top = "blinky",
    trace = True,  # Enable waveform tracing
    vopts = [
        "-Wall",
        # blinky sizes its counter from clk_freq_hz, whose default is 0, and
        # verilator 5.046 refuses the resulting [-1:0] range.
        "-Gclk_freq_hz=50000000",
        # blinky is a third-party core with lint findings (PROCASSINIT,
        # WIDTHEXPAND) that verilator 5.046 makes fatal under -Wall. Keep
        # the warnings, drop the exit status.
        "-Wno-fatal",
        "--x-assign fast",
        "--x-initial fast",
    ],
)


# bazel run //:sim
cc_binary(
    name = "sim",
    srcs = [
        "main.cc",
    ],
    deps = [
        ":lib",
    ],
)




# fusesoc_run, end to end and without a container. The core lives in this
# repository, so the example depends on nothing being fetched.
filegroup(
    name = "hello_core_files",
    srcs = glob(["cores/hello/*"]),
)

# --setup asks FuseSoC to resolve the core and write edalize's project
# files, and starts no tool. This is what proves FuseSoC itself runs in the
# sandbox. A --build example with a simulator from the registry is https://github.com/filmil/bazel_rules_fusesoc_2/issues/35.
fusesoc_run(
    name = "hello_setup",
    cores_root = "cores/hello/hello.core",
    cores_input = ":hello_core_files",
    stage_flag = "--setup",
    systems = ["example:util:hello:1.0"],
    target = "sim",
    tool = "verilator",
)

